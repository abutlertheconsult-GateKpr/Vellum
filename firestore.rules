rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Your own requests and the original file: only you
    match /requests/{id} {
      allow read, write: if request.auth != null && (
        resource == null ? request.resource.data.ownerUid == request.auth.uid
                         : resource.data.ownerUid == request.auth.uid);
      match /chunks/{c} {
        allow read, write: if request.auth != null &&
          get(/databases/$(db)/documents/requests/$(id)).data.ownerUid == request.auth.uid;
      }
    }

    // One link per signer. The long random link name is the key.
    match /links/{token} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.used == false;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if (request.auth != null && resource.data.ownerUid == request.auth.uid)
        || (resource.data.used == false
            && resource.data.expiresAt > request.time
            && request.resource.data.used == true
            && request.resource.data.signedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'result', 'signedAt', 'ua']));

      // The document itself can be read only until the link has been used (or expired)
      match /chunks/{c} {
        allow get: if get(/databases/$(db)/documents/links/$(token)).data.used == false
                   && get(/databases/$(db)/documents/links/$(token)).data.expiresAt > request.time;
        allow write: if request.auth != null &&
          get(/databases/$(db)/documents/links/$(token)).data.ownerUid == request.auth.uid;
      }
    }

    // Only needed if you install the "Trigger Email" extension
    match /mail/{id} { allow create: if request.auth != null; }
  }
}
